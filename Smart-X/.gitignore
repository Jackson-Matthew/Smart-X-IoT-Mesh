# ---------- Frontend (Vite/React/Node) ----------
frontend/**/node_modules/
frontend/**/dist/
frontend/**/dist-ssr/
frontend/**/.vite/
frontend/**/*.local

# Env files - never commit secrets
frontend/**/.env
frontend/**/.env.*
!frontend/**/.env.example

# Editor/OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Backend (.NET) ----------
backend/**/bin/
backend/**/obj/
backend/**/*.user
backend/**/*.suo
backend/**/.vs/

# .NET secrets / env
backend/**/appsettings.Development.json
backend/**/*.env

# ---------- General ----------
*.log
*.tmp